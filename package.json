{
  "name": "orquestador",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Orquestador casero de agentes de IA (núcleo/backend).",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json && tsc --noEmit -p tsconfig.desktop.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:live": "set ORQ_LIVE=1&& vitest run tests/live",
    "check": "npm run -s typecheck && npm run -s lint && npm run -s test && npm run -s build:ui && npm run -s build:desktop",
    "dev:ui": "vite --config src/ui/vite.config.ts",
    "build:ui": "vite build --config src/ui/vite.config.ts",
    "desktop": "vite build --config apps/desktop/vite.config.ts && electron apps/desktop/out",
    "desktop:dev": "vite build --config apps/desktop/vite.config.ts && set ORQ_UI_DEV=1&& set ORQ_DEVTOOLS=1&& electron apps/desktop/out",
    "build:desktop": "vite build --config apps/desktop/vite.config.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.99",
    "@ai-sdk/openai": "4.0.96",
    "@ai-sdk/openai-compatible": "3.0.71",
    "@anthropic-ai/claude-agent-sdk": "0.3.302",
    "@anthropic-ai/sdk": "0.135.0",
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@hono/node-server": "2.1.5",
    "@internationalized/date": "3.12.4",
    "@react-aria/ssr": "3.10.1",
    "@react-aria/utils": "3.34.1",
    "ai": "7.0.143",
    "hono": "4.13.13",
    "lucide-react": "1.60.0",
    "react": "19.3.1",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "ws": "8.22.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.2",
    "eslint": "9.39.5",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
